{
  "name": "rewrite-rs-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Agent skills for writing idiomatic, safe Rust and porting code into it",
  "repository": {
    "type": "git",
    "url": "https://github.com/rewrite-rs/skills"
  },
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "check": "node --test tests/*.test.mjs && node scripts/check-skills.mjs && node scripts/sync-plugin-version.mjs --check",
    "check-skills": "node scripts/check-skills.mjs",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  }
}
